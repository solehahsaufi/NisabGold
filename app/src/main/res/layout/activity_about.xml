<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Custom Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"
                app:tint="@color/gold_accent"
                xmlns:app="http://schemas.android.com/apk/res-auto"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="About"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"/>
        </LinearLayout>

        <!-- App Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NisabGold"
            android:textColor="@color/gold_accent"
            android:textStyle="bold"
            android:textSize="28sp"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gold Zakat Calculator App"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Developer Info Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DEVELOPER INFORMATION"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <!-- Developer Info Details -->
        <TextView
            android:id="@+id/tvDevInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name: [SITI NURSOLEHAH BINTI SAUFI]\nMatric No: [2024907823]\nProgramme: [CS240]\nInstitution: UiTM"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp"/>

        <!-- App Version -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VERSION"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.0.0"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

        <!-- Copyright -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2026 NisabGold. All Rights Reserved.\nDeveloped as a Mobile Technology assignment for UiTM."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Website Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="APPLICATION WEBSITE"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <!-- Clickable URL -->
        <TextView
            android:id="@+id/tvAppUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://github.com/solehahsaufi/NisabGold"
            android:textColor="@color/gold_accent"
            android:textSize="14sp"
            android:autoLink="web"
            android:linksClickable="true"/>

    </LinearLayout>
</ScrollView>